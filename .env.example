# Google Tag Manager container ID (e.g. GTM-XXXXXXX). Leave blank to disable.
NEXT_PUBLIC_GTM_ID=

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# Leave blank to disable the widget in dev; the contact form still works
# (server just skips verification), but do not ship to production without it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Once you've picked a contact-form email provider (Resend, Formspree, etc.),
# add its API key here and wire it up in app/api/contact/route.ts and
# app/api/newsletter/route.ts (both have a TODO marking where it plugs in).
# RESEND_API_KEY=
